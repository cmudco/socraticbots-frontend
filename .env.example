# REST API on Socratic backend; chat Socket.IO connects directly to DARE.
VITE_API_URL=http://localhost:8001/api
VITE_DARE_SOCKET_URL=http://localhost:8000
# DARE web app, used for links that hand the user over to DARE.
VITE_DARE_FRONTEND_URL=http://localhost:5173

VITE_APP_NAME=Socratic Bots
VITE_APP_VERSION=
# Public browser configuration only; never put service secrets here.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
