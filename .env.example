# Socratic Bots backend REST API (all REST calls go here).
VITE_API_URL=http://localhost:8001/api
# DARE backend; the chat Socket.IO connection goes directly to DARE's /chat namespace.
VITE_DARE_SOCKET_URL=http://localhost:8000
# DARE web app, used for links that hand the user over to DARE (for example billing).
VITE_DARE_FRONTEND_URL=http://localhost:5173

# Optional error reporting. Browser config only: never put service secrets in VITE_* vars.
# Sentry DSN used by production builds.
# VITE_SENTRY_DSN=
# Sentry DSN used by `npm run dev` only (separate local-testing project).
# VITE_LOCAL_SENTRY_DSN=
# Environment tag sent to Sentry (defaults to the Vite mode).
# VITE_SENTRY_ENVIRONMENT=development
